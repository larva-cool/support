{
  "name": "larva/support",
  "description": "common components",
  "keywords": [
    "support",
    "http",
    "larva"
  ],
  "license": "MIT",
  "support": {
    "issues": "https://github.com/larvatech/support/issues",
    "source": "https://github.com/larvatech/support"
  },
  "authors": [
    {
      "name": "Larva Team",
      "email": "support@larva.com.cn"
    }
  ],
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "ext-simplexml": "*",
    "ext-libxml": "*",
    "ext-fileinfo": "*",
    "nesbot/carbon": "^3.8",
    "guzzlehttp/guzzle": "^8.0.1",
    "ezyang/htmlpurifier": "^4.14"
  },
  "require-dev": {
    "mockery/mockery": "^1.5",
    "phpunit/phpunit": "^11.3",
    "friendsofphp/php-cs-fixer": "^3.17"
  },
  "autoload": {
    "psr-4": {
      "Larva\\Support\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "scripts": {
    "post-merge": "composer install",
    "check-style": "./vendor/bin/php-cs-fixer fix --using-cache=no --diff --dry-run --ansi",
    "fix-style": "./vendor/bin/php-cs-fixer fix --using-cache=no --ansi",
    "test": "./vendor/bin/phpunit --colors"
  },
  "scripts-descriptions": {
    "test": "Run all tests.",
    "check-style": "Run style checks (only dry run - no fixing!).",
    "fix-style": "Run style checks and fix violations."
  }
}
